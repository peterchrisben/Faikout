{
    "elements": [
        {
            "type": "Label",
            "name": "Overview",
            "caption": ""
        },
        {
            "type": "ValidationTextBox",
            "name": "Hostname",
            "caption": "Hostname of the Faikout",
            "width": "400px"
        },
        {
            "type": "Label",
            "caption": "Enter the hostname exactly as shown in the web interface of the Faikout. The Faikout sends its data to the MQTT server of Symcon: in its web interface, enter the IP address of Symcon as MQTT server (port 1883 unless changed) and the user and password of the MQTT server instance."
        },
        {
            "type": "CheckBox",
            "name": "AllowControl",
            "caption": "Allow control (switch the air conditioner and change values from Symcon)"
        },
        {
            "type": "Label",
            "name": "LegacyInfo",
            "caption": "Taken over from \"Faikin 4 Daikin\": control stays allowed, so existing schedules and scripts keep working.",
            "visible": false
        },
        {
            "type": "Button",
            "name": "RevokeLegacy",
            "caption": "Withdraw this approval",
            "visible": false,
            "confirm": "Control will then only be possible with the tick above. Continue?",
            "onClick": "IPS_RequestAction($id, 'RevokeLegacy', '');"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Select values",
            "items": [
                {
                    "type": "Label",
                    "caption": "A value only appears once the Faikout reports it – not every air conditioner has every function. Unticked values are removed, unless they are archived: then they stay and keep being updated. To remove such a value, switch off its archiving first."
                },
                {
                    "type": "List",
                    "name": "ValueSelection",
                    "caption": "Values",
                    "rowCount": 15,
                    "add": false,
                    "delete": false,
                    "loadValuesFromConfiguration": false,
                    "columns": [
                        {
                            "caption": "Show",
                            "name": "Show",
                            "width": "80px",
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Group",
                            "name": "Group",
                            "width": "150px"
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "auto"
                        },
                        {
                            "caption": "Current value",
                            "name": "Value",
                            "width": "160px"
                        },
                        {
                            "caption": "Archive",
                            "name": "Archive",
                            "width": "170px"
                        },
                        {
                            "caption": "Ident",
                            "name": "Ident",
                            "width": "0px",
                            "visible": false,
                            "save": true
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Tick all",
                            "onClick": "FAIKIN_SelectAllValues($id, true);"
                        },
                        {
                            "type": "Button",
                            "caption": "Untick all",
                            "onClick": "FAIKIN_SelectAllValues($id, false);"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Request status now",
            "onClick": "IPS_RequestAction($id, 'RequestStatus', '');"
        },
        {
            "type": "Label",
            "name": "DeviceInfo",
            "caption": ""
        },
        {
            "type": "Label",
            "name": "ControlResult",
            "caption": ""
        },
        {
            "type": "ExpansionPanel",
            "caption": "Settings of the Faikout",
            "items": [
                {
                    "type": "Label",
                    "caption": "These settings are stored in the Faikout itself. \"Live status\" sends every change at once – recommended. Report interval 0 = no regular report."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "DevReporting",
                            "caption": "Report interval (seconds)",
                            "minimum": 0,
                            "maximum": 3600,
                            "width": "260px",
                            "value": 60
                        },
                        {
                            "type": "CheckBox",
                            "name": "DevLivestatus",
                            "caption": "Live status",
                            "value": false
                        },
                        {
                            "type": "CheckBox",
                            "name": "DevHA",
                            "caption": "Messages for Home Assistant",
                            "value": true
                        }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Send to the Faikout",
                    "confirm": "Send these settings to the Faikout?",
                    "onClick": "IPS_RequestAction($id, 'SendSettings', json_encode(['reporting' => $DevReporting, 'livestatus' => $DevLivestatus, 'haenable' => $DevHA]));"
                },
                {
                    "type": "Button",
                    "caption": "Restart the Faikout",
                    "confirm": "Restart the Faikout now? The air conditioner keeps running.",
                    "onClick": "FAIKIN_RestartDevice($id);"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Please enter the hostname of the Faikout"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No message from the Faikout for 5 minutes"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "MQTT server not active"
        }
    ]
}
